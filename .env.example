# PostgreSQL is opt-in through an explicit YAML storage backend selection.
# Use distinct databases and least-privilege roles without BYPASSRLS.
# Production URLs must set sslmode=require, verify-ca, or verify-full.
# ORIA_PLATFORM_DATABASE_URL=postgresql://oria_platform:password@localhost:5432/oria_platform?sslmode=require
# ORIA_BUSINESS_DATABASE_URL=postgresql://oria_business:password@localhost:5432/oria_business?sslmode=require

# Real PostgreSQL integration tests are separately selected enterprise checks.
# ORIA_TEST_PLATFORM_POSTGRES_DSN=postgresql://oria_test:password@localhost:5432/oria_platform_test
# ORIA_TEST_BUSINESS_POSTGRES_DSN=postgresql://oria_test:password@localhost:5432/oria_business_test
